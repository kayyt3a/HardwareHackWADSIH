# Anthropic API key (vision + label reading)
ANTHROPIC_API_KEY=

# TTS provider: "openai" or "local" (local = pyttsx3, no network, lower quality)
TTS_PROVIDER=openai
OPENAI_API_KEY=

# Confidence below this triggers a "please reposition" response instead of
# speaking a (possibly wrong) label read
CONFIDENCE_THRESHOLD=0.55
